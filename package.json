{
  "name": "top-cleaning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs --test \"src/**/*.test.mts\"",
    "check:i18n": "node scripts/check-i18n.mjs",
    "fonts:build": "python3 scripts/build-fonts.py",
    "fonts:check": "python3 scripts/build-fonts.py --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "video:token": "node scripts/new-video-token.mjs",
    "video:qr": "node scripts/make-qr.mjs",
    "video:stream": "node --experimental-strip-types scripts/stream.mjs",
    "telegram:chat-id": "node scripts/telegram-chat-id.mjs"
  },
  "dependencies": {
    "next": "15.5.24",
    "next-intl": "4.14.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@opennextjs/cloudflare": "1.20.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.24",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "qrcode": "1.5.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "wrangler": "4.127.1"
  }
}
