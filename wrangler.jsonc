{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "top-cleaning",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // The site is live at https://topcleaning.md (attached to this Worker as a Custom
  // Domain). Turning the workers.dev subdomain off retires
  // https://top-cleaning.ibeep.workers.dev, which was serving the whole site a second
  // time under a second hostname — duplicate content and an unwanted public entry
  // point. Custom Domains are unaffected by this flag.
  "workers_dev": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // NEXT_PUBLIC_SITE_URL is inlined by Next at build time, so it belongs in the
  // build environment (.env / CI env), not in `vars` here — see .env.example.
  //
  // Cloudflare Stream credentials are secrets, not vars:
  //   wrangler secret put CF_ACCOUNT_ID
  //   wrangler secret put CF_STREAM_API_TOKEN
  //   wrangler secret put CF_STREAM_SIGNING_KEY_ID
  //   wrangler secret put CF_STREAM_SIGNING_KEY_PEM
}
